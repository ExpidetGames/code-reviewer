{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "installCommand": "pnpm install --frozen-lockfile --filter code-reviewer-dispatcher...",
  "regions": ["fra1"],
  "functions": {
    "src/index.ts": {
      "maxDuration": 1800
    }
  },
  "crons": [
    {
      "path": "/api/cron/reap-sandboxes",
      "schedule": "*/5 * * * *"
    }
  ]
}
