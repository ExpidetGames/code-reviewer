{
  "name": "code-reviewer-dispatcher",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/node.ts",
    "snapshot:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/snapshot/main.ts",
    "snapshot:ops": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/snapshot/ops-main.ts",
    "probe:canary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/probe/canary-main.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:int": "vitest run --project integration",
    "test:privileged": "vitest run --project privileged"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@vercel/functions": "^3.10.1",
    "@vercel/sandbox": "^3.8.0",
    "hono": "^4.13.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24.19.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "ajv": "^8.20.0",
    "eslint": "^9",
    "prettier": "^3.9.10",
    "rolldown": "1.2.13",
    "typescript": "^5",
    "typescript-eslint": "^8.71.2",
    "undici-types": "7.24.6",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24"
  }
}
