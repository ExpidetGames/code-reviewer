    {
      "ecosystem": "python",
      "package": "PyGithub",
      "licenses": ["LicenseRef-LGPL"],
      "reason": "Required by PR-Agent; used unmodified as a library. Only the generic LGPL classifier is declared."
    },
    {
      "ecosystem": "python",
      "package": "python-gitlab",
      "licenses": ["LGPL-3.0-or-later"],
      "reason": "Required by PR-Agent; used unmodified as a library."
    },
    {
      "ecosystem": "python",
      "package": "tqdm",
      "licenses": ["MPL-2.0"],
      "reason": "Required by PR-Agent's dependencies; used unmodified."
    }
