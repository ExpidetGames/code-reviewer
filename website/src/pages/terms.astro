---
// Legal text drafted without a lawyer (October 2026). Have it reviewed by one before relying on it.
// The text itself lives in src/content/terms.ts. Changing it means changing TERMS_VERSION there, and the
// application (BILLING_TERMS_VERSION) has to follow.
import Base from "../layouts/Base.astro";
import LegalDocument from "../components/LegalDocument.astro";
import PageHeader from "../components/PageHeader.astro";
import TextLink from "../components/TextLink.astro";
import { TERMS_DE, TERMS_EN } from "../content/terms";
import { LEGAL_READY } from "../site";
import { ogPath } from "../lib/blog";
---

<Base
  title="Terms of service"
  description="Terms of service (AGB) of the hosted code-review.com for businesses: prepaid credit in US dollars, Stripe payment, source code, data processing, liability."
  ogImage={ogPath("/terms/")}
  noindex={!LEGAL_READY}
>
  <article aria-labelledby="terms-title">
    <PageHeader
      id="terms-title"
      lines={["Terms of service"]}
      lead="The terms for the hosted version of code-review.com, for businesses only. The German version (AGB) is the legally binding one; an English translation follows."
    />
    <div class="px-6 pb-16 md:px-8 md:pb-24">
      <div class="mx-auto flex max-w-3xl flex-col gap-16">
        <nav aria-label="Language" class="flex gap-4 text-sm">
          <TextLink href="#terms-de">Deutsch</TextLink>
          <TextLink href="#terms-en">English</TextLink>
        </nav>
        <LegalDocument document={TERMS_DE} id="terms-de" />
        <LegalDocument document={TERMS_EN} id="terms-en" />
      </div>
    </div>
  </article>
</Base>
