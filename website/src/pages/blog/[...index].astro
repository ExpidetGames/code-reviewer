---
// The blog overview at /blog/. It is only built once there is a first article in src/content/blog/ (see blogIsLive in
// src/lib/blog.ts): getStaticPaths returns no path while the blog is empty, so there is no empty page to find.
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PostCard from "../../components/PostCard.astro";
import { blogIsLive, getPosts, ogPath } from "../../lib/blog";
import { breadcrumbs } from "../../lib/seo";

export async function getStaticPaths() {
  return (await blogIsLive()) ? [{ params: { index: undefined } }] : [];
}

const posts = await getPosts();
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
];
---

<Base
  title="Blog"
  description="Articles about AI code review on GitHub pull requests: how reviews work, what they find and how to get the most out of them."
  ogImage={ogPath("/blog/")}
  schema={[breadcrumbs(crumbs)]}
>
  <div class="mx-auto max-w-6xl px-6 pt-40 pb-16 md:px-8">
    <Breadcrumbs items={crumbs} />
    <h1 class="text-3xl font-semibold tracking-tight">Blog</h1>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</Base>
