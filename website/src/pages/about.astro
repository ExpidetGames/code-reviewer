---
import Base from "../layouts/Base.astro";
import ButtonLink from "../components/ButtonLink.astro";
import Icon from "../components/Icon.astro";
import PageHeader from "../components/PageHeader.astro";
import TextLink from "../components/TextLink.astro";
import { Image } from "astro:assets";
import founders from "../assets/founders.webp";
import { ABOUT } from "../content/about";
import { CTA, LINKS } from "../content/nav";
import { ogPath } from "../lib/blog";
import { inline } from "../lib/inline";
---

<Base
  title="About us: the team behind code-review.com | Itegro GmbH"
  description="Itegro GmbH is a small software company from Geretsried near Munich. We build the tools our own startup is missing and turn them into simple hosted services."
  ogImage={ogPath("/about/")}
>
  <article aria-labelledby="about-title">
    <PageHeader id="about-title" lines={[...ABOUT.headingLines]} lead={ABOUT.subheading} center />

    <div class="px-6 md:px-8">
      <figure data-reveal="scroll" class="mx-auto max-w-5xl">
        <div class="rounded-2xl border border-line bg-surface p-2">
          <Image
            src={founders}
            alt={ABOUT.photo.alt}
            widths={[640, 1024, 1536, 2048]}
            sizes="(min-width: 1024px) 1008px, 100vw"
            loading="eager"
            class="h-auto w-full rounded-lg"
          />
        </div>
        <figcaption class="mt-3 text-center text-sm text-muted">{ABOUT.photo.caption}</figcaption>
      </figure>
    </div>

    <div class="px-6 py-16 md:px-8 md:py-24">
      <div class="mx-auto flex max-w-3xl flex-col gap-12">
        {
          ABOUT.sections.map((section) => (
            <section data-reveal="scroll" class="grid gap-4 md:grid-cols-3 md:gap-8">
              <h2 class="text-xl font-semibold text-fg">{section.heading}</h2>
              <div class="flex flex-col gap-4 md:col-span-2">
                {section.paragraphs.map((paragraph) => (
                  <p class="text-lg text-muted" set:html={inline(paragraph)} />
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>

    <div class="px-6 pb-16 md:px-8 md:pb-24">
      <div data-reveal="scroll" class="mx-auto flex max-w-3xl flex-col items-center gap-6 rounded-2xl border border-line bg-surface px-6 py-12 text-center">
        <p class="text-lg text-muted">
          {ABOUT.closing}{" "}
          <TextLink href={LINKS.itegro} class="text-fg">itegro-gmbh.de</TextLink>.
        </p>
        <ButtonLink href={CTA.href} location="about">
          {CTA.primary}
          <Icon name="arrowRight" size={16} />
        </ButtonLink>
      </div>
    </div>
  </article>
</Base>
