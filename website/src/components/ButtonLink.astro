---
// A link styled as a button. Links to the app carry `location` (where on the page they are), which the
// cta_clicked event reports; see src/lib/cta.ts.
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"a">, "class"> {
  href: string;
  variant?: "primary" | "secondary";
  size?: "main" | "header";
  /** `full` inside the nav pill. */
  shape?: "lg" | "full";
  location?: string;
  class?: string;
}
const { href, variant = "primary", size = "main", shape = "lg", location, class: className, ...rest } = Astro.props;

const variants = {
  primary: "bg-fg text-page hover:bg-muted",
  secondary: "border border-line-strong bg-surface text-fg hover:bg-raised-strong",
};
const sizes = { main: "text-base", header: "text-sm" };
---

<a
  href={href}
  data-cta-location={location}
  class:list={[
    "inline-flex items-center justify-center gap-2 px-3 py-2 font-semibold transition-all duration-700 ease-fluid select-none hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg active:translate-y-0 active:scale-98",
    shape === "full" ? "rounded-full" : "rounded-lg",
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
