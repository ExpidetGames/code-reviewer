---
import { blogIsLive } from "../lib/blog";
import { FOOTER_COLUMNS } from "../content/nav";
import Logo from "./Logo.astro";

// The "Cookie settings" link only exists when analytics (and so the consent dialog) are built in.
const trackingEnabled = Boolean(import.meta.env.PUBLIC_POSTHOG_KEY);
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const columns = FOOTER_COLUMNS.map((column) => ({
  ...column,
  links: column.links.filter((link) => !link.consent || trackingEnabled),
}));
if ((await blogIsLive()) && columns[1]) columns[1].links = [...columns[1].links, { label: "Blog", href: "/blog/" }];

const linkClasses =
  "rounded-sm text-sm transition-all duration-700 ease-fluid hover:text-fg active:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg";
---

<footer id="site-footer" class="border-t border-line bg-page">
  <div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 md:grid-cols-4 md:px-8">
    <div class="flex flex-col gap-3">
      <a href="/" class:list={[linkClasses, "w-max"]} aria-label="code-review.com, home">
        <Logo />
      </a>
      <p class="max-w-xs text-sm text-muted">Simple code reviews for every GitHub pull request. Made in Germany by Itegro GmbH.</p>
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <h2 class="text-sm font-semibold text-fg">{column.title}</h2>
          <ul class="mt-4 flex flex-col gap-3">
            {column.links.map((link) => {
              const here = link.href.startsWith("/") && link.href.replace(/\/$/, "") === pathname;
              return (
                <li>
                  <a
                    href={link.href}
                    data-cookie-settings={link.consent ? "" : undefined}
                    data-cta-location={link.location}
                    aria-current={here ? "page" : undefined}
                    class:list={[linkClasses, here ? "font-semibold text-fg" : "text-muted"]}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-6 text-xs text-muted md:flex-row md:justify-between md:px-8">
      <p>© {new Date().getFullYear()} Itegro GmbH · <span class="whitespace-nowrap">code-review.com</span></p>
      <p>Follows your system theme</p>
    </div>
  </div>
</footer>
