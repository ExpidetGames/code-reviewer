---
// Base layout of every page: SEO head, structured data, header and footer, consent and tracking.
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { DESCRIPTION, LANG, LOCALE, NAME, SITE_URL } from "../site";
import { absolute, jsonLd, pageTitle, siteGraph } from "../lib/seo";
import { blogIsLive, ogPath } from "../lib/blog";

interface Props {
  /** Page title without " | NAME". Without it the page is only called NAME. */
  title?: string;
  /** Meta description, 70–160 characters. */
  description?: string;
  /** Preview image (path), e.g. ogPath("/pricing/"). Default: the one of the home page. Images are made in pages/og/. */
  ogImage?: string;
  noindex?: boolean;
  type?: "website" | "article";
  published?: Date;
  modified?: Date;
  /** More JSON-LD nodes of this page (breadcrumbs, FAQ, article …). */
  schema?: object[];
}

const { title, description = DESCRIPTION, noindex = false, type = "website", published, modified, schema = [] } =
  Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, `${SITE_URL}/`).toString();
const image = absolute(Astro.props.ogImage ?? ogPath("/"));
const fullTitle = pageTitle(title);
const blog = await blogIsLive();
---

<!doctype html>
<html lang={LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {blog && <link rel="alternate" type="application/rss+xml" title={`${NAME} Blog`} href="/rss.xml" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:locale" content={LOCALE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="code-review.com: simple code reviews for every GitHub pull request" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" set:html={jsonLd([...siteGraph(), ...schema])} />
  </head>
  <body class="min-h-dvh bg-page font-sans text-base text-fg">
    <a
      href="#main"
      class="sr-only rounded-lg bg-fg px-3 py-2 text-sm font-semibold text-page focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-60 focus:outline-2 focus:outline-offset-2 focus:outline-fg"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />

    <script>
      import "../lib/menu";
      import { setupConsent, showConsentSettings } from "../lib/consent";
      import { setupCtaTracking } from "../lib/cta";

      void setupConsent();
      setupCtaTracking();
      for (const link of document.querySelectorAll("[data-cookie-settings]")) {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          void showConsentSettings();
        });
      }
    </script>
  </body>
</html>
