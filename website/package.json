{
  "name": "code-review-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "itegroVorlage": "1.0.1",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && tsc --noEmit -p worker",
    "check:export": "node scripts/check-export.mjs",
    "verify": "pnpm check && pnpm legal:check && pnpm build && pnpm check:export",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro",
    "legal:md": "node --no-warnings scripts/export-legal-markdown.mjs",
    "legal:check": "node --no-warnings scripts/export-legal-markdown.mjs --check"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "klaro": "^0.7.21",
    "posthog-js": "^1.438.21",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@fontsource/geist": "^5.3.0",
    "node-html-parser": "^9.0.5",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  },
  "description": "The code-review.com landing page (Astro, Cloudflare Workers static assets)"
}
