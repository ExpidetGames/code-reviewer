# Fallback for builders that do not read the Dockerfile-specific ignore files
# (app/Dockerfile.dockerignore, runner/Dockerfile.dockerignore): the classic builder
# (DOCKER_BUILDKIT=0, Docker before 23, Compose v1) only reads this file. BuildKit prefers the
# file next to the Dockerfile and never reads this one for these two images; the three files
# list the same exclusions, and app/src/ci/dockerfiles.test.ts keeps them from drifting apart.
#
# The build context of both images is the repository root. It needs the app/ and runner/ folders
# and the three license files, nothing else.

# Default deny: only these parts of the repository are part of the build context.
*
!app
!runner
!LICENSE
!NOTICE
!THIRD_PARTY_LICENSES.md

# Never in an image: environment files, keys, certificates, local databases. These match at any
# depth (a pattern without a leading **/ only matches in the root of the context).
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3
**/*.sqlite-shm
**/*.sqlite-wal

# Version control and editor files
**/.git
**/.DS_Store
app/.gitignore
app/.github
app/.vscode
app/.idea
runner/.gitignore
runner/.vscode
runner/.idea

# Host build output, dependencies and caches (the images install and build their own)
**/node_modules
app/.next
app/out
app/build
app/dist
app/coverage
**/*.tsbuildinfo
app/next-env.d.ts
app/.pnpm-store
runner/.venv
**/.venv
runner/venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
runner/.pytest_cache
runner/.ruff_cache
runner/.mypy_cache
runner/.pyright

# Tests and test tooling
app/e2e
app/integration-tests
app/playwright-report
app/test-results
**/*.test.ts
**/*.test.tsx
**/*.integration.test.ts
**/*.integration.test.tsx
**/*.e2e.ts
app/src/test-support
app/src/ci
app/vitest.config.mts
app/playwright.config.ts
app/playwright.dynamic.config.ts
app/playwright.hosted.config.ts
runner/tests
runner/test-results

# Docker files themselves
app/Dockerfile
app/Dockerfile.dockerignore
runner/Dockerfile
runner/Dockerfile.dockerignore
