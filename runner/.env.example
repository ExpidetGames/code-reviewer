# Variables of the runner container (the job loop, `code-reviewer-runner`). Placeholders only: never
# put a real value into this file. Documented in runner/README.md, "The job loop".
#
# Where the app is and the token it expects (the same value as RUNNER_TOKEN of the app).
RUNNER_API_URL=http://app:3000
RUNNER_TOKEN=
#
# Jobs at the same time. One PR-Agent process needs about 320 MB: floor((MiB - 256) / (321 * 1.5)),
# so 3 for a container limit of 2 GiB (docs/spike/cr-13-measurements.md).
RUNNER_CONCURRENCY=3
# Hard timeout of one job in seconds (20 minutes). The loop ends a job that does not stop about 10
# seconds later.
RUNNER_JOB_TIMEOUT_SECONDS=1200
# Wait between two claims when nothing is waiting, and the time running jobs get after SIGTERM.
RUNNER_POLL_INTERVAL_SECONDS=5
RUNNER_SHUTDOWN_GRACE_SECONDS=60
# Optional: a name for this runner in the app's logs (default runner-<hostname>).
# RUNNER_ID=
