#!/bin/bash
# SPDX-License-Identifier: LicenseRef-Proprietary
#
# Accident guard of the Implementer (#761): a git `reference-transaction` hook that keeps the agent on
# its branch and tells the runner about every commit. The image installs it root-owned and read-only at
# /opt/code-reviewer/guard/; the Worker points `core.hooksPath` at that directory per job through a
# GIT_CONFIG_SYSTEM file under /run (the image bakes no hooksPath in).
#
# It is a guard against accidents (amend, reset, rebase, a branch switch, a new branch or tag), not a
# security boundary: `git -c core.hooksPath=/dev/null` and a hand-written ref file get around it. The
# guarantee is the runner's push check (fetch without force, ancestor check, push from a mirror), which
# the spool below only hints at. Needs git 2.53 or newer: older git does not run the hook for a change
# of HEAD, so a branch switch is invisible to it (the matrix, guard_matrix.sh, fails on older git).
#
# $1 is prepared|committed|aborted; stdin has "<old> <new> <ref>" per updated ref. git passes the zero id
# as <old> in many updates, so the current tip is read from the repository (unchanged while `prepared`).
#
# Configuration (shell variables, a file only root can write; the Worker writes it per turn):
#   BRANCH  the branch the agent works on        START  the commit it started from
#   SPOOL   an append-only file the agent's user can write: one "<time> <sha>" line per tip update
# The file is read from $CODE_REVIEWER_GUARD_CONF, by default /run/code-reviewer/guard.conf. A missing or
# incomplete file denies everything: a guard that silently allows is worse than none.
conf=${CODE_REVIEWER_GUARD_CONF:-/run/code-reviewer/guard.conf}
zero=0000000000000000000000000000000000000000
state=$1
lines=()
while read -r line; do lines+=("$line"); done

deny() {
  echo "code-reviewer-guard: $*" >&2
  exit 1
}

[ -r "$conf" ] || deny "the guard configuration is missing"
# shellcheck disable=SC1090 # the file is written by the Worker at run time
. "$conf"
[ -n "${BRANCH:-}" ] && [ -n "${START:-}" ] && [ -n "${SPOOL:-}" ] || deny "the guard configuration is incomplete"

branch_ref="refs/heads/$BRANCH"
current=$(git rev-parse -q --verify "$branch_ref")

if [ "$state" = prepared ]; then
  # What the branch becomes in this transaction: a HEAD update with an object id is allowed only
  # together with an update of the branch to the same id.
  branch_new=""
  for line in "${lines[@]}"; do
    # shellcheck disable=SC2086 # split into the three fields on purpose
    set -- $line
    [ "$3" = "$branch_ref" ] && branch_new=$2
  done
  for line in "${lines[@]}"; do
    # shellcheck disable=SC2086
    set -- $line
    new=$2
    ref=$3
    case "$ref" in
      "$branch_ref")
        [ "$new" = "$zero" ] && deny "deleting $BRANCH is not allowed"
        if [ -n "$current" ] && ! git merge-base --is-ancestor "$current" "$new"; then
          deny "$BRANCH may only move forward"
        fi
        git merge-base --is-ancestor "$START" "$new" || deny "the tip must contain the start commit"
        ;;
      HEAD)
        case "$new" in
          ref:*) [ "$new" = "ref:$branch_ref" ] || deny "HEAD may only point at $BRANCH" ;;
          *) [ -n "$branch_new" ] && [ "$new" = "$branch_new" ] || deny "HEAD may only follow $BRANCH" ;;
        esac
        ;;
      refs/stash | refs/remotes/* | ORIG_HEAD | FETCH_HEAD | MERGE_HEAD | CHERRY_PICK_HEAD | REVERT_HEAD | AUTO_MERGE | REBASE_HEAD) : ;;
      *) deny "updating $ref is not allowed" ;;
    esac
  done
elif [ "$state" = committed ]; then
  for line in "${lines[@]}"; do
    # shellcheck disable=SC2086
    set -- $line
    [ "$3" = "$branch_ref" ] && echo "$(date +%s.%N) $2" >>"$SPOOL"
  done
fi
exit 0
