# Keeps the build context small and keeps secrets, tests and local data out of the image.
# Only pyproject.toml, uv.lock, .python-version and src/ are used by the Dockerfile.

# Never in an image: environment files, keys, certificates, local databases
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
*.p12
*.db
*.sqlite
*.sqlite3

# Version control and editor files
.git
.gitignore
.vscode
.idea
.DS_Store

# Host virtual environment and caches (the image builds its own)
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache
.pyright

# Tests
tests
test-results

# Docker files themselves
Dockerfile
.dockerignore
