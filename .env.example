# Settings for `docker compose` (compose.yml). Copy this file to `.env` next to compose.yml and fill
# in the values: `cp .env.example .env`. `.env` is git-ignored; never commit real values. Every
# setting below is read by compose.yml or by the app or runner it starts. Settings marked
# "required" stop `docker compose up` before any container is created when they are empty. Compose
# only catches empty values: the app also validates them (RUNNER_TOKEN of at least 32 characters,
# https for BETTER_AUTH_URL beyond localhost) and exits with one line when one is invalid; see
# `docker compose logs app`.
#
# For development without Docker, the app has its own list: app/.env.example.

# --- Images ---

# Which images to run. The defaults are the images that CI publishes to GHCR for the development
# branch (the packages are private: `docker login ghcr.io` once). Pin a commit with sha-<short
# commit> or follow `latest` (branch main). Ignored when you build locally with compose.build.yml.
# APP_IMAGE=ghcr.io/expidetgames/code-reviewer-app:development
# RUNNER_IMAGE=ghcr.io/expidetgames/code-reviewer-runner:development

# --- Reaching the app ---

# The host port and address the app is published on. The container always listens on 3000. The
# default address is loopback only; use 0.0.0.0 to reach the app from other machines (behind a
# reverse proxy with https, see BETTER_AUTH_URL). An IPv6 address needs brackets: [::1]
# APP_PORT=3000
# APP_BIND_ADDRESS=127.0.0.1

# The address people use to reach the app, without a path. An https address makes the cookies
# Secure; plain http is only accepted for localhost. GitHub sends people back to
# <this>/api/auth/callback/github, so register exactly that address as "Authorization callback URL"
# in the GitHub OAuth app below. Left unset, compose uses http://localhost:<APP_PORT>, which is right
# for a local try-out. Set it as soon as the app is reached under another address or port; beyond
# localhost it must be https, otherwise the app refuses to start (and `unless-stopped` restarts it
# in a loop: read `docker compose logs app`).
# BETTER_AUTH_URL=https://reviews.example.com

# --- Sign in with GitHub ---

# Required. Signs the session cookie and encrypts the stored GitHub tokens. At least 32 characters,
# random, never reused between environments. Create one with: openssl rand -base64 32
# Changing it signs everybody out.
BETTER_AUTH_SECRET=

# Required. A GitHub OAuth app of its own (GitHub > Settings > Developer settings > OAuth Apps),
# not the GitHub App below. The client secret is generated on its settings page.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Who may sign in. Set at least one of the two, otherwise nobody can sign in (the app still starts
# and logs one warning). If both are set, either one is enough.
# Comma separated GitHub logins, for example: octocat,hubot. A login can be bound to its numeric
# GitHub id as octocat:583231 (see app/src/auth/README.md for why and how).
ALLOWED_GITHUB_LOGINS=
# A GitHub organization whose members may sign in (the name as in github.com/<name>).
ALLOWED_GITHUB_ORG=

# --- GitHub App (reads pull requests, posts the reviews) ---

# Required. Create the app once as described in docs/github-app.md. The values are on the settings page
# of the GitHub App (GitHub > Settings > Developer settings > GitHub Apps). The slug is the last part of the app's URL: github.com/apps/<slug>.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Required. The secret you entered as "Webhook secret" in the App settings. Deliveries are only
# accepted when they are signed with it. The webhook URL is <public address>/api/webhooks/github-app.
GITHUB_APP_WEBHOOK_SECRET=
# Required. The private key (PEM) generated on the App settings page, on one line with the line
# breaks written as \n inside double quotes: "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=
# Alternative to GITHUB_APP_PRIVATE_KEY for the app without compose: a path to the PEM file. The
# compose file does not mount a key file, so set GITHUB_APP_PRIVATE_KEY here.
# GITHUB_APP_PRIVATE_KEY_PATH=

# --- Runner ---

# Required. The shared secret between the app and the runner: the runner presents it to the app's
# runner API. At least 32 characters, random. Create one with: openssl rand -base64 32
# The app and the runner read it from this one variable.
RUNNER_TOKEN=

# --- LLM ---

# One LLM access shared by the team; the app hands the key to the runner for each job. Not needed
# for the stack to start: without a key the app runs and shows a configuration error, and review
# jobs fail. The key is never logged or shown.
# LLM_PROVIDER=openrouter
LLM_API_KEY=

# Optional. The model reviews use unless the review settings choose another: the OpenRouter name of
# the model, for example anthropic/claude-haiku-5.5 (the default; the runner adds the openrouter/
# prefix). A value that is not a model name is ignored with a start-up warning.
# LLM_MODEL=anthropic/claude-haiku-5.5
# Optional. The context window (in tokens) of a model PR-Agent does not know; leave it unset for known
# models. A whole number from 1000 to 10000000 (for example 163840); anything else is ignored with a
# start-up warning. Left empty on purpose: this is not a secret, but the name looks like one to the
# check that keeps values out of this file.
# LLM_MAX_TOKENS=

# --- Automatic reviews ---

# Optional. A push to a pull request waits this many seconds before its review may start, so several
# pushes in a row produce one review (opened, reopened and ready-for-review reviews start at once). A
# whole number from 0 to 600; empty or anything else means the default of 90.
# REVIEW_DEBOUNCE_SECONDS=90

# --- Database ---

# How long a database write waits for a lock, in milliseconds (1 to 2147483647). Default: 5000.
# The database file itself is /data/app.db in the volume named `data`; DATABASE_PATH is set by the
# image and is not changed here.
# DATABASE_BUSY_TIMEOUT_MS=5000

# --- Backups ---

# The app backs up the database once a day into the volume `backups` (/backups in the container,
# kept 7 daily and 4 weekly). This is the time of day in UTC, written HH:MM; "off" switches the
# schedule off (then something else must back up the database, for example a Coolify scheduled
# task running the same command). Default: 02:30. How to restore, and how to get the backups off the
# server: app/src/backup/README.md.
# BACKUP_TIME=02:30
# Where the backups go. The image fixes it to /backups, the mount point of the volume; changing it
# only makes sense for the app without Docker. It must not lie inside the database directory: the
# app refuses a target next to the data, because a backup there is lost with the data.
# BACKUP_DIR=/backups

# --- Test stack only ---

# Send the sign in to a fake GitHub instead of github.com, and the API calls to a fake GitHub API.
# The addresses are refused unless the flag is set too. Never set these in a real deployment; the
# compose file does not pass them on.
# ALLOW_TEST_GITHUB_ENDPOINTS=true
# GITHUB_OAUTH_BASE_URL=http://127.0.0.1:4010
# GITHUB_API_BASE_URL=http://127.0.0.1:4010
