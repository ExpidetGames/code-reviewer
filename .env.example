# Settings for the Docker Compose stack (compose.yml) that the team uses as a test and development
# fixture. code-review.com is not self-hostable and the source is not licensed for hosting (LICENSE);
# this stack is not a way to run the service elsewhere. Copy this file to `.env` next to compose.yml and fill
# in the values: `cp .env.example .env`. `.env` is git-ignored; never commit real values. Every
# setting below is read by compose.yml or by the app or runner it starts.
#
# Only two settings are required: APP_SECRET and RUNNER_TOKEN (and BETTER_AUTH_URL as soon as the app
# is reached under another address than localhost). Everything else is optional. A new instance is
# set up in the browser: on its first start the app prints a setup code in its log
# (`docker compose logs app`), you enter it in the browser and answer three questions (single or
# multi tenant, who may sign up, the admin account).
#
# RUNNER_TOKEN, when empty, stops `docker compose up` before any container is created. Compose only
# catches empty values: the app also validates them (APP_SECRET and RUNNER_TOKEN of at least 32
# characters, https for BETTER_AUTH_URL beyond localhost) and exits with one line when one is
# missing or invalid; see `docker compose logs app`.
#
# For development without Docker, the app has its own list: app/.env.example.

# --- Images ---

# Which images to run. No image is published; the defaults are the tags that compose.build.yml
# builds from this checkout (`docker compose -f compose.yml -f compose.build.yml up --build`).
# APP_IMAGE=code-reviewer-app:local
# RUNNER_IMAGE=code-reviewer-runner:local

# --- Reaching the app ---

# The host port and address the app is published on. The container always listens on 3000. The
# default address is loopback only; use 0.0.0.0 to reach the app from other machines (behind a
# reverse proxy with https, see BETTER_AUTH_URL). An IPv6 address needs brackets: [::1]
# APP_PORT=3000
# APP_BIND_ADDRESS=127.0.0.1

# Required beyond a local try-out. The address people use to reach the app, without a path. An https
# address makes the cookies Secure; plain http is only accepted for localhost. GitHub sends people
# back to <this>/api/auth/callback/github, the "Callback URL" of the GitHub App (the one-click setup
# in the admin portal registers it for you). Left unset, compose uses http://localhost:<APP_PORT>, which is right
# for a local try-out. Set it as soon as the app is reached under another address or port; beyond
# localhost it must be https, otherwise the app refuses to start (and `unless-stopped` restarts it
# in a loop: read `docker compose logs app`).
# BETTER_AUTH_URL=https://reviews.example.com

# --- The instance ---

# Required. The master key of the instance: it signs the session cookie and encrypts the credentials
# stored in the database. At least 32 characters, random, never reused between environments. Create
# one with: openssl rand -base64 32
# Keep a copy that is NOT in the database backups: a database restored without its APP_SECRET loses
# every stored credential, and the secret cannot be recovered. Changing it signs everybody out.
# The app refuses to start without it and names this variable.
APP_SECRET=

# Deprecated: the old name of APP_SECRET. An installation from before APP_SECRET keeps working with
# it: the app uses it as APP_SECRET when APP_SECRET is empty (and logs once that it is deprecated),
# so that sessions and encrypted tokens stay valid. Updating an installation: add APP_SECRET with
# the SAME value, then remove this one. Two different values sign everybody out and make the GitHub
# tokens of the earlier sign in unreadable (the update then cannot check an allowed organization).
# BETTER_AUTH_SECRET=

# --- GitHub (optional) ---

# A new instance starts without any of the settings in this section, and a new instance does not
# need them: the GitHub App (it reads pull requests, posts the reviews and signs people in) is created
# or entered in the admin portal, under Integrations, and stored encrypted in the database
# (docs/github-app.md). What is below is only for an installation that already has these values and
# is updated: on its first start with accounts the app imports them ONCE (the GitHub App and the LLM
# key into the encrypted store, the allow list into who becomes a member, in one transaction after a
# backup) and ignores them from then on, saying so in the log (names only, never values). Remove them
# when the short setup is done; see "Updating from a version before accounts" in README.md. On a new
# instance they are ignored, with one line in the log.

# No longer used. The separate GitHub OAuth app of the earlier sign in is replaced by the user
# authorization of the GitHub App (client id and secret are entered in the portal). They are not
# imported; the update only mentions in the admin portal that they were set.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# The allow list of the earlier sign in. It no longer decides who may sign in: the sign-up rule and
# the workspaces do (admin portal, Setup). The update to accounts reads it once, at import time, to
# decide who becomes a member of the default workspace (docs/decisions/0001-editions-setup-and-
# accounts.md, section 2.11): the people on the list whose login is bound to their GitHub account, and
# the members of the organization (a live check with each person's own stored GitHub token). The first
# of them to have signed in becomes the Owner. Nobody else becomes a member; the admin portal lists them.
# The list and the organization are NOT turned into a sign-up rule: choose that in the setup wizard.
# Comma separated GitHub logins, for example: octocat,hubot. A login can be bound to its numeric
# GitHub id as octocat:583231 (see app/src/auth/README.md).
ALLOWED_GITHUB_LOGINS=
# A GitHub organization whose members were allowed (the name as in github.com/<name>). Read once like
# the list above; it is not migrated into a rule, and the admin portal says how to recreate that
# access (an email list or allowed domains).
ALLOWED_GITHUB_ORG=

# The GitHub App of an installation that has not been updated yet; imported once into the encrypted
# store (id, slug, private key, webhook secret). The values are on the settings page of the GitHub App
# (GitHub > Settings > Developer settings > GitHub Apps). Set all four or none: a value that is missing
# or unusable is not imported, the log and the admin portal name the variable (never the value), and
# GitHub stays not configured until the App is entered in the portal. The slug is the last part of the
# app's URL: github.com/apps/<slug>.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The secret you entered as "Webhook secret" in the App settings. Deliveries are only accepted when
# they are signed with it. The webhook URL is <public address>/api/webhooks/github-app.
GITHUB_APP_WEBHOOK_SECRET=
# The private key (PEM) generated on the App settings page, on one line with the line breaks written
# as \n inside double quotes: "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=
# Alternative to GITHUB_APP_PRIVATE_KEY for the app without compose: a path to the PEM file. The
# compose file does not mount a key file, so set GITHUB_APP_PRIVATE_KEY here.
# GITHUB_APP_PRIVATE_KEY_PATH=

# --- Runner ---

# Required. The shared secret between the app and the runner: the runner presents it to the app's
# runner API. At least 32 characters, random. Create one with: openssl rand -hex 32
# The app and the runner read it from this one variable.
RUNNER_TOKEN=

# Optional. Switches on the operator API (/api/operator/v1): a machine interface, protected by this bearer token,
# with which an external service reads workspaces and sets their entitlements (limits, key mode, suspension).
# Leave it out and the API does not exist (its paths answer 404). At least 32 characters, random, and different
# from RUNNER_TOKEN, APP_SECRET and BETTER_AUTH_SECRET. Create one with: openssl rand -hex 32. See contracts/operator-api.v1.json.
# OPERATOR_API_TOKEN=

# Optional. How runners learn about a queued job: `poll` (the default: runners ask the app) or `webhook` (the app
# sends a signed wake-up call to a Dispatcher after it queued a job; the hosted deployment on a serverless
# platform, see app/src/dispatch/README.md). Webhook mode needs RUNNER_WEBHOOK_URL (https) and
# RUNNER_WEBHOOK_SECRET: at least 32 characters, random, and different from every other secret (RUNNER_TOKEN,
# APP_SECRET, BETTER_AUTH_SECRET, OPERATOR_API_TOKEN, CRON_SECRET, ...). Create one with: openssl rand -hex 32.
# The Dispatcher gets the same key as DISPATCHER_SIGNING_KEY_ID / DISPATCHER_SIGNING_SECRET.
# RUNNER_DISPATCH=poll
# RUNNER_WEBHOOK_URL=
# RUNNER_WEBHOOK_SECRET=
# RUNNER_WEBHOOK_KEY_ID=k1
# While rotating the key: the key being replaced (both or neither); the app signs with the current key only.
# RUNNER_WEBHOOK_SECRET_PREVIOUS=
# RUNNER_WEBHOOK_KEY_ID_PREVIOUS=
# The platform's deployment protection bypass token, when the Dispatcher project is protected.
# RUNNER_WEBHOOK_BYPASS_TOKEN=
# Webhook mode, the once-a-minute sweep (app/src/dispatch/README.md): a job that waited this many seconds (60 to 604800)
# without a claim fails with dispatch_unavailable. Default 3600 in webhook mode, off when runners poll; 0 turns it off.
# RUNNER_DISPATCH_GIVE_UP_SECONDS=3600
# Webhook mode: send no more wake-up calls than there are free slots below this cap (1 to 1000, the Dispatcher's
# DISPATCHER_MAX_RUNNING). Unset: the Dispatcher's own cap is the only limit.
# RUNNER_DISPATCH_MAX_RUNNING=

# Optional. How many reviews the runner runs at the same time, 1 to 32. Each one is a PR-Agent process
# of about 320 MB at its peak, and the runner container is limited to 2 GiB (RUNNER_MEMORY_LIMIT), so
# the default is 3 (about 1.5 per GiB). Raise it only together with that limit: the table in
# docs/deployment-coolify.md, section 9, gives the pairs.
# RUNNER_CONCURRENCY=3

# Optional. The memory limit of the runner container, as Docker writes it (for example 2g or 1536m).
# Default: 2g. Keep it in step with RUNNER_CONCURRENCY: more parallel reviews than the memory allows get
# processes killed and show up as failed runs.
# RUNNER_MEMORY_LIMIT=2g

# Optional. The hard timeout of one review, in seconds (default 1200, 20 minutes). The runner ends a
# review that runs longer and reports it as `timeout`.
# RUNNER_JOB_TIMEOUT_SECONDS=1200

# Optional. How long the runner waits between two requests for work when nothing is waiting, in
# seconds (default 5).
# RUNNER_POLL_INTERVAL_SECONDS=5

# Optional. A name for this runner in the app's logs (letters, digits and ._:@-, 64 at most). Empty:
# runner-<host name of the container>.
# RUNNER_ID=

# --- Dynamic Review runner (compose.dynamic.yml, opt-in; a service of compose.coolify.yml) ---
#
# On Coolify the runner-dynamic service is part of compose.coolify.yml and is built and started with
# the rest (docs/deployment-coolify.md, "Dynamic Review runner"); the settings below apply there too,
# with the one difference named at RUNNER_DYNAMIC_CAPABILITIES.
#
# compose.dynamic.yml adds a second runner for Dynamic Review next to the Diff one, built from this
# checkout (`docker compose -f compose.yml -f compose.dynamic.yml up -d --build --wait`). Its image
# carries the pinned stock OpenCode. The runner advertises `opencode` only after its startup
# self-check passed, and Dynamic Review itself stays off until the instance admin turns the gate on
# (Admin, Setup, Instance, Dynamic Review; default off). See docs/dynamic-review.md for the activation
# steps and the rollback. The Diff runner above is not affected. None of these settings holds a secret.

# Optional. A prebuilt image of the Dynamic runner instead of the one compose builds. Default:
# code-reviewer-runner-dynamic:local, built from the `dynamic` target of runner/Dockerfile.
# RUNNER_DYNAMIC_IMAGE=code-reviewer-runner-dynamic:local

# Optional. How many jobs the Dynamic runner runs at the same time, 1 to 32. Default 1: one Dynamic
# slot. Do not raise it before the worst-case memory measurements of docs/dynamic-review.md exist.
# RUNNER_DYNAMIC_CONCURRENCY=1

# Optional. The memory limit and the soft reservation of the Dynamic runner container, as Docker
# writes them. Defaults 2g and 1536m: at least 1 GiB per Dynamic slot plus the runner and proxy
# reserve (an unvalidated, conservative figure). The container gets no swap.
# RUNNER_DYNAMIC_MEMORY_LIMIT=2g
# RUNNER_DYNAMIC_MEMORY_RESERVATION=1536m

# Optional, and normally empty. The app reads the model's capabilities, window and prices from
# OpenRouter's public model metadata when a Dynamic job is claimed and sends them with the job, so any
# tool-capable model runs without this. Set it only to narrow that: a JSON description such as
# {"tool_choice_required": true, "structured_output": true, "max_output_tokens": 8192,
# "input_usd_per_mtok": 0.5, "output_usd_per_mtok": 2} is a CEILING for every model of this runner
# (both must support the features, the smaller output limit and window win, the higher unit price wins);
# a job can never widen it. Empty: the job's description applies; without one (an older app, or the
# metadata could not be read) the description built into the runner for the default model,
# deepseek/deepseek-v4.1-flash, applies to that exact id only, and a job of any other model fails with
# dynamic_model_features_unsupported. A value that is set but unusable fails the job. There is no
# fallback to another model or to a Diff review.
# RUNNER_DYNAMIC_CAPABILITIES=
# The JSON may also name "context_window_tokens" (without it, no window ceiling applies when the job
# brings one, else a conservative 128,000). Without a job description from the app, a model other than
# the default MUST have "input_usd_per_mtok" and "output_usd_per_mtok" here (used to reserve the cost of
# a call before it is sent): a model with no unit costs anywhere fails every job with
# dynamic_config_invalid. See docs/dynamic-review.md, "The model".

# Optional, and only a fallback since the maximum cost per review is set in the admin portal (General,
# Limits; #689): the app sends it with every job and a job that carries it ignores this variable. It
# holds only for a Dynamic job from an app that does not send the maximum (a release rolling out).
# The most one Dynamic Review run may cost, in USD, as a plain decimal number such as 2.5.
# Empty: the runner's default (1.00). A value that is not a positive number up to the ceiling in the
# runner (20) fails every Dynamic job with dynamic_config_invalid. Trusted operator configuration:
# nothing in a repository or a pull request can change it. A run is stopped when the next call could
# take it over the limit, or when the provider reports no cost for a call.
# RUNNER_DYNAMIC_MAX_COST_USD=

# Not settings, so they are written without an equals sign. The Dynamic runner loop runs as root (the
# Dynamic job process is the supervisor that starts the engine as another user, see
# docs/dynamic-review.md, "The engine boundary"); the compose file therefore sets
# RUNNER_DIFF_JOB_USER=10001:10001 so that PR-Agent jobs drop to the unprivileged runner user, and
# the image's dedicated engine user is 10101:10101 (RUNNER_DYNAMIC_ENGINE_UID and
# RUNNER_DYNAMIC_ENGINE_GID, trusted runner configuration, never repository input). Changing them
# in .env changes nothing; they belong to the image.
#
# The compose files fix where the runner finds
# the app: RUNNER_API_URL is always http://app:3000, over the compose network. They also leave
# RUNNER_SHUTDOWN_GRACE_SECONDS at the runner's 60 seconds, the time running reviews may finish after
# `docker compose stop`; the runner container gets 90 seconds to stop (stop_grace_period), which only
# works with that grace period. Setting either of the two in .env changes nothing.
# RUNNER_API_URL: fixed to http://app:3000 by the compose files
# RUNNER_SHUTDOWN_GRACE_SECONDS: left at 60 by the compose files

# --- LLM ---

# LEGACY. Every workspace enters its own LLM key in the UI (Settings, LLM access); that is the normal way.
# The update of an existing installation imports this key ONCE into the default workspace (encrypted, bound
# to the provider) and does not read it afterwards. A new instance ignores it. Not needed for the stack
# to start. The key is never logged or shown.
# LLM_PROVIDER=openrouter
LLM_API_KEY=

# Optional. The model reviews use unless the review settings choose another: the OpenRouter name of
# the model, for example anthropic/claude-haiku-5.5 (the default; the runner adds the openrouter/
# prefix). A workspace on the operator's own key (key mode managed, docs/deployment-vercel.md,
# section 3.5) always uses this model and ignores the model of its review settings. A value that is
# not a model name is ignored with a start-up warning. The update of an existing installation also
# copies a model that differs from the default into the review defaults of the default workspace, so
# removing this variable later does not change the model.
# LLM_MODEL=anthropic/claude-haiku-5.5
# Optional. The context window (in tokens) of a model PR-Agent does not know; leave it unset for known
# models. A whole number from 1000 to 10000000 (for example 163840); anything else is ignored with a
# start-up warning. Left empty on purpose: this is not a secret, but the name looks like one to the
# check that keeps values out of this file.
# LLM_MAX_TOKENS=

# Optional, default off. Set to 1 (or true, on) to run Dynamic reviews on OpenRouter and Anthropic through the native OpenCode
# path (#578, design #544, docs/dynamic-review.md "The native path of a job"): the claim carries the model entry and price of
# the catalog (models.dev) and the runner starts the passthrough proxy. With it on, a model for the operator's key must be
# enabled with a confirmed price in the catalog, and every runner and Worker image must be a release that reads the entry.
# Anything else, or unset, keeps the path of today. Read at every claim.
# NATIVE_OPENCODE_PROVIDERS=

# --- Database ---

# The database. Empty, a path or a `sqlite:` URL means SQLite (the image fixes the file to
# /data/app.db in the volume named `data`); a `postgres://` or `postgresql://` URL means an external
# Postgres (the large topology, docs/deployment-large.md). Nothing ever logs the password of the URL.
# DATABASE_URL=
#
# How long a SQLite write waits for a lock held by another connection, in milliseconds
# (1 to 2147483647). Ignored for Postgres. Default: 5000.
# DATABASE_BUSY_TIMEOUT_MS=5000
#
# The most connections the Postgres pool opens (1 to 1000). Ignored for SQLite. Default: 10.
# DATABASE_POOL_MAX=10

# --- Model catalog ---

# Optional. The model catalog (app/src/models-dev/README.md): once a day the app reads the public catalog models.dev
# (prices, limits and capability flags of the models of the providers the pinned OpenCode can drive) into the database, so
# a new model needs no release. A failed or implausible fetch keeps the rows it has. MODELS_DEV_URL is where it is read from
# (default https://models.dev/api.json): point it at a mirror when the instance cannot reach the internet.
# MODELS_DEV_URL=https://models.dev/api.json
#
# `off` (also `false`, `0`, `no`) switches the fetch off, for an air-gapped instance: no call is made, the catalog stays
# empty and nothing else changes. Anything else leaves it on.
# MODELS_DEV_FETCH=on

# --- Serverless runtime (a hosted deployment on a serverless platform; docker compose never sets these) ---
# The whole hosted deployment, with a table of every variable of both Vercel projects: docs/deployment-vercel.md.

# How the app runs: `server` (a long-lived process: Docker, Coolify; the default) or `serverless`
# (functions that start cold and many at a time). Empty means `server`, except on the hosting platform,
# which is recognized by VERCEL=1 and selects `serverless` by itself. In serverless mode the database must
# be Postgres (SQLite is refused at the start), the pool is small (DATABASE_POOL_MAX defaults to 3 and
# is limited to 20), nothing is migrated, imported, synchronized or scheduled at start, and
# /api/health answers 503 while the database lacks a migration of this version.
# APP_RUNTIME=server
#
# VERCEL: set to 1 by the hosting platform itself; never set it by hand. It only selects the default of
# APP_RUNTIME.
#
# The DIRECT Postgres URL (not a pooler that ends a session between statements) that `pnpm migrate`
# connects to. It applies the migrations behind a session advisory lock; run it at deployment time,
# before the new version takes traffic. Required for that command only; the app never reads it.
# DATABASE_URL_MIGRATE=
#
# The secret with which the platform's cron calls /api/internal/repository-sync (the daily sync with
# GitHub) and /api/internal/dispatch-sweep (once a minute: lapsed leases, resends, the give-up, the hourly
# cleanup), serverless mode only. At least 32 characters: openssl rand -hex 32. Without it the route
# refuses every caller.
# CRON_SECRET=

# --- Backups ---

# The app backs up the database once a day into the volume `backups` (/backups in the container,
# kept 7 daily and 4 weekly). This is the time of day in UTC, written HH:MM; "off" switches the
# schedule off (then something else must back up the database, for example a Coolify scheduled
# task running the same command). Default: 02:30. How to restore, and how to get the backups off the
# server: app/src/backup/README.md.
# BACKUP_TIME=02:30
# Where the backups go. The image fixes it to /backups, the mount point of the volume; changing it
# only makes sense for the app without Docker. It must not lie inside the database directory: the
# app refuses a target next to the data, because a backup there is lost with the data.
# BACKUP_DIR=/backups

# --- Test stack only ---

# The command that runs one review instead of PR-Agent, for test stacks with a fake. The runner hands
# the whole job to it, including the GitHub token and the LLM key. Never set it in a real deployment:
# the compose files do not pass it on, and the one that does (docker/smoke/compose.fake-job.yml) is
# only used by the compose smoke test.
# PR_AGENT_COMMAND: set only by docker/smoke/compose.fake-job.yml, for example to "python /smoke/fake_job.py"

# Send the sign in to a fake GitHub instead of github.com, and the API calls to a fake GitHub API.
# The addresses are refused unless the flag is set too. Never set these in a real deployment; the
# compose file does not pass them on.
# ALLOW_TEST_GITHUB_ENDPOINTS=true
# GITHUB_OAUTH_BASE_URL=http://127.0.0.1:4010
# GITHUB_API_BASE_URL=http://127.0.0.1:4010

# Check LLM keys (the "test key" button of the LLM access settings) at a fake LLM instead of the provider.
# The address is ignored unless the flag is set too. A key is sent to it, so never set these in a real
# deployment; the compose files do not pass them on.
# ALLOW_TEST_LLM_ENDPOINTS=true
# LLM_API_BASE_URL=http://127.0.0.1:4011/api/v1

# Send the Stripe API calls of billing to a fake Stripe instead of Stripe (the e2e stack of the billing page, fakes/stripe).
# The address is ignored unless the flag is set too, and even then only plain http on a loopback address is accepted, because
# the API key is sent to it. Never set these in a real deployment; the compose files do not pass them on. Billing is
# configured in the admin portal and in nothing else: these two are not settings.
# ALLOW_TEST_STRIPE_ENDPOINTS=true
# STRIPE_API_BASE_URL=http://127.0.0.1:4012

# Longer pauses (milliseconds, at most five of at most 10000) between the repeats of a wake-up to the Dispatcher inside the
# request that queued a job, for a test lane that starts its Dispatcher itself. Ignored unless the flag is set too;
# never set these in a real deployment (the compose files do not pass them on).
# ALLOW_TEST_DISPATCH_TIMING=true
# TEST_DISPATCH_INLINE_RETRY_DELAYS_MS=2000,6000,10000
