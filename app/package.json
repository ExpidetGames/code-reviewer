{
  "name": "code-reviewer-app",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write . ../fakes",
    "format:check": "prettier --check . ../fakes",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "licenses:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/ci/license-check/cli.ts",
    "spdx:add": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/ci/spdx-headers/cli.ts --write",
    "spdx:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/ci/spdx-headers/cli.ts --check"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.6",
    "next": "16.4.0",
    "nodemailer": "10.0.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/eslint-plugin": "^1.6.27",
    "ajv": "^8.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-playwright": "^2.12.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24"
  }
}
