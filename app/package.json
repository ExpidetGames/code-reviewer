{
  "name": "code-reviewer-app",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write . ../fakes",
    "format:check": "prettier --check . ../fakes",
    "setup-code": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/setup/setup-code-cli.ts",
    "migrate": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/db/migrate-cli.ts",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:hosted": "playwright test -c playwright.hosted.config.ts",
    "licenses:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/ci/license-check/cli.ts",
    "spdx:add": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/ci/spdx-headers/cli.ts --write",
    "spdx:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/ci/spdx-headers/cli.ts --check",
    "contracts:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/ci/contract-types/cli.ts --write",
    "contracts:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/ci/contract-types/cli.ts --check",
    "opencode-providers:derive": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/ci/opencode-providers/cli.ts --write"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/functions": "^3.10.1",
    "better-auth": "1.7.7",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.29.6",
    "next": "16.4.2",
    "nodemailer": "10.0.16",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/eslint-plugin": "^1.6.27",
    "ajv": "^8.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-playwright": "^2.12.1",
    "jsdom": "^30.1.2",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24"
  }
}
