# SPDX-License-Identifier: LicenseRef-Proprietary

# The network guard of the privileged Dynamic e2e lane (#253). Loaded by runner/scripts/run_dynamic_e2e.sh
# as root, in the lane's own network namespace, before anything else starts. The namespace has loopback
# and a default route that leads nowhere (a veth pair nothing answers on), so a connection attempt to any
# other address reaches the output hook, where this chain counts and rejects it: at once, with an error
# in the process that tried, never a hang.
#
# It is in the kernel, so it sees every process alike: the pinned OpenCode as the engine user, Git (the fake
# GitHub's upload-pack, the runner's checkout), ripgrep, Node, a shell, whatever else starts. It counts
# per user: the engine user of the Dynamic image (10101), the Diff job user (10001), root, and anyone else.
# The runner installs its own table for the engine user (priority 0, after this one); that table is the
# production boundary and stays untouched.
#
# Two kinds of counters, read by e2e/helpers/dynamic-lane-guard.ts:
#   violation-*  a connection to anything but loopback. The lane must end with all of them at zero.
#   control-*    a connection to 192.0.2.0/24 (TEST-NET-1, reserved for documentation, never routed). The
#                lane itself connects there as each kind of process to prove the counters move.
#   dns-*        a query to port 53 (UDP or TCP) on loopback, where the lane's own resolver (e2e/helpers/lane-dns-stub.ts) answers
#                "no such name" at once, so nothing of it leaves the namespace and the violation counters never see it. These
#                counters do (#714): the engine user must not ask for any name (its counter must end at zero), and the names asked
#                by anyone are compared with e2e/dynamic/dns-allowlist.txt. The rules take no verdict and sit before the loopback
#                accept; dns-control-engine is the engine user's query to 127.0.0.2:53, nothing answers there, which proves that
#                the counters move for the engine without a name lookup that would fail the lane.
# A rule without a counter name above would not be read, so every counter has the comment the reader looks for.

add table inet cr_lane_guard
flush table inet cr_lane_guard
add chain inet cr_lane_guard output { type filter hook output priority -10 ; policy accept ; }

# Name lookups on loopback (the lane's own resolver), per user, before loopback is accepted. Only the control accepts.
add rule inet cr_lane_guard output oifname "lo" ip daddr 127.0.0.2 meta l4proto udp th dport 53 meta skuid 10101 counter accept comment "dns-control-engine"
add rule inet cr_lane_guard output oifname "lo" meta l4proto { tcp, udp } th dport 53 meta skuid 10101 counter comment "dns-engine"
add rule inet cr_lane_guard output oifname "lo" meta l4proto { tcp, udp } th dport 53 meta skuid 10001 counter comment "dns-job"
add rule inet cr_lane_guard output oifname "lo" meta l4proto { tcp, udp } th dport 53 meta skuid 0 counter comment "dns-root"
add rule inet cr_lane_guard output oifname "lo" meta l4proto { tcp, udp } th dport 53 meta skuid != { 0, 10001, 10101 } counter comment "dns-other"

# Loopback is the only way to the fakes.
add rule inet cr_lane_guard output oifname "lo" accept

add rule inet cr_lane_guard output ip daddr 192.0.2.0/24 meta skuid 10101 counter reject comment "control-engine"
add rule inet cr_lane_guard output ip daddr 192.0.2.0/24 meta skuid 10001 counter reject comment "control-job"
add rule inet cr_lane_guard output ip daddr 192.0.2.0/24 meta skuid 0 counter reject comment "control-root"

add rule inet cr_lane_guard output meta skuid 10101 counter reject comment "violation-engine"
add rule inet cr_lane_guard output meta skuid 10001 counter reject comment "violation-job"
add rule inet cr_lane_guard output meta skuid 0 counter reject comment "violation-root"
add rule inet cr_lane_guard output meta skuid != { 0, 10001, 10101 } counter reject comment "violation-other"
