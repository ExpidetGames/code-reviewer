# Copy to app/.env.local for local development. Placeholders only: never commit real values.

# Path of the SQLite database file. Its directory must exist and be writable; the file itself is
# created and migrated when the server starts. Default when unset: /data/app.db (the volume of the
# Docker image). The value below keeps local data in the git-ignored /data folder of the repository
# (run `mkdir data` in the repository root once); relative paths resolve from the app/ folder.
DATABASE_PATH=../data/app.db

# Optional. How long a write waits for a lock held by another connection, in milliseconds
# (whole number from 1 to 2147483647). Default: 5000.
# DATABASE_BUSY_TIMEOUT_MS=5000

# --- Sign in with GitHub (Better Auth). All four are required; the server refuses to start without
# them and names what is missing. ---

# Signs the session cookie and encrypts the stored GitHub tokens. At least 32 characters, random,
# never reused between environments. Create one with: openssl rand -base64 32
# It signs the session cookie and encrypts the stored GitHub access token. Changing it signs
# everybody out and makes the stored tokens unreadable (they are replaced at the next sign in).
# (Left empty on purpose: the server will not start until you fill it in.)
BETTER_AUTH_SECRET=

# The address people use to reach the app, without a path. An https address makes the cookies
# Secure; in production plain http is only accepted for localhost (browsers drop Secure cookies
# over http). Local development: http://localhost:3000
# (or the port you start `pnpm dev` on). GitHub sends people back to <this>/api/auth/callback/github,
# so register exactly that address as "Authorization callback URL" in the GitHub OAuth app below.
BETTER_AUTH_URL=http://localhost:3000

# A GitHub OAuth app of its own (GitHub > Settings > Developer settings > OAuth Apps), not the
# GitHub App that reviews pull requests. The client secret is generated on its settings page.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Who may use this instance. Set at least one of the two; with neither set NOBODY can sign in
# (the server starts, logs one warning, and every sign in is refused). If both are set, either one
# is enough. ---

# Comma separated GitHub logins that may sign in, for example: octocat,hubot
# Not case sensitive, spaces and empty entries are ignored, whole logins only. Checked on every
# request, so a login removed from the list loses access at once (after restarting the server with
# the changed value).
# A login is a name, not an identity: GitHub frees an old name after a rename, and somebody else can
# take it. So a listed login is bound to the GitHub id of the first account that signs in with it
# (table allowed_login_pins); another account with the same login is refused at sign in and on every
# request, and its sessions are ended. To bind a login before anybody signs in (closes the gap that
# a squatter signs in first), give the numeric GitHub id: octocat:583231,hubot
# (https://api.github.com/users/<login> shows the id). The id is 1 to 20 digits without a leading
# zero. An entry that is not a valid login or login:id is ignored (admits nobody) and the start logs
# one ACCESS_LIST_ENTRY_INVALID warning. An id given here replaces a different stored binding when
# the server starts. When a listed person renames their account: put the new login on the list (with
# or without the id), remove the old one, restart; the old binding is deleted at the start and the
# new login is bound at the next sign in. The binding only concerns this list: a member of
# ALLOWED_GITHUB_ORG is admitted by the organization alone.
ALLOWED_GITHUB_LOGINS=

# Optional. A GitHub organization whose members may sign in (the name as in github.com/<name>).
# Asking GitHub about the membership needs the `read:org` scope, which the sign in then requests
# (only when this is set). The membership is checked at sign in and again after 24 hours, with the
# person's stored token; if GitHub cannot be asked, the person is turned away. A member whose
# organization limits third-party OAuth apps must have the app approved there.
# ALLOWED_GITHUB_ORG=

# The GitHub App (our own app, created once by hand). Without these the app still starts, but nothing
# can be read from GitHub: the sync at start logs GITHUB_APP_CONFIG_INVALID and names what is missing.
# The numeric id of the app (the "App ID" on the app's settings page).
# GITHUB_APP_ID=123456
# The app's URL name: github.com/apps/<slug>. The bot acts as <slug>[bot].
# GITHUB_APP_SLUG=code-reviewer
# The private key (PEM) of the app, either as the content of the variable (line breaks may be written
# as \n) or as the path of the .pem file. Use one of the two; never commit the key.
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
# The secret set in the app's webhook settings; deliveries are checked against it.
# GITHUB_APP_WEBHOOK_SECRET=<the secret from the app's webhook settings>

# --- Test stack only: point GitHub at the fake GitHub (fakes/github) instead of github.com. ---
# GITHUB_API_BASE_URL is where the GitHub API is reached (GitHub App JWT and installation tokens, the
# sign in's user and organization lookups). GITHUB_OAUTH_BASE_URL is where the sign in's authorize
# and token exchange go. Both are origins (the paths are GitHub's own). Defaults: https://api.github.com
# and https://github.com. Secrets are sent to these addresses (the client secret, the App JWT), so
# any other value is refused unless ALLOW_TEST_GITHUB_ENDPOINTS=true; the server then refuses to
# start with a message that names the variable (naming the real GitHub is always fine). Never set
# any of the three in production.
# ALLOW_TEST_GITHUB_ENDPOINTS=true
# GITHUB_OAUTH_BASE_URL=http://127.0.0.1:4010
# GITHUB_API_BASE_URL=http://127.0.0.1:4010

# --- Runner API. The runner (runner/) claims jobs over HTTP and proves itself with one shared token.
# Without RUNNER_TOKEN every call of the runner API is refused (401), and so with one shorter than 32
# characters (the server logs a warning at start). The same value in the runner's environment. Create one with: openssl rand -hex 32
# RUNNER_TOKEN=

# --- The shared LLM access. One account serves the whole instance; the app hands the key to the runner
# with every job. Without a usable configuration the app still starts and shows a configuration error
# in the UI (the start logs one LLM_NOT_CONFIGURED warning; it is the provider and the key that matter), and every job fails when it is claimed
# with the error code llm_not_configured. The key is never logged, stored or shown. ---

# The provider. Required. Only "openrouter" is supported for now.
LLM_PROVIDER=openrouter

# The API key of that provider (OpenRouter: openrouter.ai/keys). Required. Surrounding whitespace and
# a trailing line break are ignored. Keep it out of version control; only .env.local holds the value.
LLM_API_KEY=

# Optional. The model reviews use unless the review settings choose another. The OpenRouter name of the
# model, such as anthropic/claude-haiku-5.5 (without an openrouter/ prefix, the runner adds it).
# Default: anthropic/claude-haiku-5.5. A value that is not a model name is ignored with a start-up
# warning and the default is used.
# LLM_MODEL=anthropic/claude-haiku-5.5

# Optional. The context window (in tokens) of a model PR-Agent does not know; leave it unset for known
# models. A whole number from 1000 to 10000000; anything else is ignored with a start-up warning. The
# token budget of a review is a review setting and replaces this value in a job.
# LLM_MAX_TOKENS=163840

# --- Automatic reviews. Optional. A push to a pull request waits this many seconds before its review
# may start, so several pushes in a row produce one review (opened, reopened and ready-for-review
# reviews start at once). A whole number from 0 to 600; anything else is ignored and the default is
# used. Default: 90. ---
# REVIEW_DEBOUNCE_SECONDS=90
