# Copy to app/.env.local for local development. Placeholders only: never commit real values.

# Path of the SQLite database file. Its directory must exist and be writable; the file itself is
# created and migrated when the server starts. Default when unset: /data/app.db (the volume of the
# Docker image). The value below keeps local data in the git-ignored /data folder of the repository
# (run `mkdir data` in the repository root once); relative paths resolve from the app/ folder.
DATABASE_PATH=../data/app.db

# Optional. How long a write waits for a lock held by another connection, in milliseconds
# (whole number from 1 to 2147483647). Default: 5000.
# DATABASE_BUSY_TIMEOUT_MS=5000

# --- The instance. APP_SECRET and BETTER_AUTH_URL are required; the server refuses to start without
# them and names what is missing. ---

# The master key of the instance. It signs the session cookie and encrypts the credentials stored in
# the database. At least 32 characters, random, never reused between environments. Create one with:
# openssl rand -base64 32
# Keep a copy apart from the database backups: a database restored without it loses every stored
# credential. Changing it signs everybody out and makes the stored tokens unreadable (they are
# replaced at the next sign in).
# (Left empty on purpose: the server will not start until you fill it in.)
APP_SECRET=

# Deprecated: the old name of APP_SECRET, still used as APP_SECRET while APP_SECRET is empty (and
# logged once as deprecated), so that an installation from before APP_SECRET keeps its sessions.
# BETTER_AUTH_SECRET=

# The address people use to reach the app, without a path. An https address makes the cookies
# Secure; in production plain http is only accepted for localhost (browsers drop Secure cookies
# over http). Local development: http://localhost:3000
# (or the port you start `pnpm dev` on). GitHub sends people back to <this>/api/auth/callback/github,
# so that exact address is the "Callback URL" of the GitHub App (the one-click setup in the admin
# portal registers it for you).
BETTER_AUTH_URL=http://localhost:3000

# --- First start. A new instance is set up in the browser: while it is not set up, every start of the
# server prints a fresh 6-digit setup code in its log (a line starting with "[setup] Setup code:").
# Open the app, enter the code and answer three questions (single or multi tenant, who may sign up,
# the admin account). Nothing about it is configured here. ---

# --- The GitHub App and "Sign in with GitHub" are configured in the admin portal (Integrations), not
# here: one click creates the App, or you enter its values by hand, and they are stored encrypted in the
# database (docs/github-app.md). What follows is only for an installation that already has these
# values: they are read as long as the database holds no GitHub App, and the update to accounts imports
# them once. ---

# No longer used: the separate GitHub OAuth app of the earlier sign in is replaced by the user
# authorization of the GitHub App, and is never imported.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- The allow list of the earlier sign in. It is ignored: it no longer decides who may sign in. The
# sign-up rule and the workspaces do (admin portal, Setup). The server logs one ALLOW_LIST_IGNORED
# warning at start while either variable is set. They are still passed through (compose.yml,
# compose.coolify.yml) only because the update to accounts (#106) reads them once to decide who becomes
# a member (docs/decisions/0001-editions-setup-and-accounts.md, section 2.11). ---

# Comma separated GitHub logins, for example: octocat,hubot. A login can be bound to its numeric
# GitHub id as octocat:583231 (see src/auth/README.md).
ALLOWED_GITHUB_LOGINS=

# A GitHub organization whose members were allowed (the name as in github.com/<name>).
# ALLOWED_GITHUB_ORG=

# The GitHub App of an installation that has not been updated yet (docs/github-app.md). All four
# settings below are optional for starting the server: without them, and without an App in the
# database, GitHub is not configured and nothing can be read from GitHub. Set all four or none; a
# partial set or an unusable private key (it must be a parseable RSA key) is reported in the log at
# start, naming the variables.
# The numeric id of the app (the "App ID" on the app's settings page).
# GITHUB_APP_ID=123456
# The app's URL name: github.com/apps/<slug>. The bot acts as <slug>[bot].
# GITHUB_APP_SLUG=code-reviewer
# The private key (PEM) of the app, either as the content of the variable (line breaks may be written
# as \n) or as the path of the .pem file. Use one of the two; never commit the key.
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
# The secret set in the app's webhook settings; deliveries are checked against it.
# GITHUB_APP_WEBHOOK_SECRET=<the secret from the app's webhook settings>

# --- Test stack only: point GitHub at the fake GitHub (fakes/github) instead of github.com. ---
# GITHUB_API_BASE_URL is where the GitHub API is reached (GitHub App JWT and installation tokens, the
# sign in's user and email lookups, the manifest conversion). GITHUB_OAUTH_BASE_URL is where GitHub's
# web pages are (the sign in's authorize and token exchange, the creation page of the manifest flow). Both are origins (the paths are GitHub's own). Defaults: https://api.github.com
# and https://github.com. Secrets are sent to these addresses (the client secret, the App JWT), so
# any other value is refused unless ALLOW_TEST_GITHUB_ENDPOINTS=true; the server then refuses to
# start with a message that names the variable (naming the real GitHub is always fine). Never set
# any of the three in production.
# ALLOW_TEST_GITHUB_ENDPOINTS=true
# GITHUB_OAUTH_BASE_URL=http://127.0.0.1:4010
# GITHUB_API_BASE_URL=http://127.0.0.1:4010

# Check LLM keys (the "test key" button of the LLM access settings) at a fake LLM instead of the provider.
# The address is ignored unless the flag is set too. A key is sent to it, so never set these in a real
# deployment; the compose files do not pass them on.
# ALLOW_TEST_LLM_ENDPOINTS=true
# LLM_API_BASE_URL=http://127.0.0.1:4011/api/v1

# --- Deployment settings. The production server (the Docker image, `pnpm start`) refuses to start
# without them and names what is missing; `pnpm dev` does not check them. For Docker Compose they
# are set in the .env file next to compose.yml (see .env.example there). ---

# Runner API. The runner (runner/) claims jobs over HTTP and proves itself with one shared token,
# the same value in the runner's environment. The production server refuses to start without it.
# Without RUNNER_TOKEN every call of the runner API is refused (401), and so with one shorter than
# 32 characters (the server logs a warning at start). At least 32 characters, random.
# Create one with: openssl rand -hex 32
RUNNER_TOKEN=

# --- LEGACY: the LLM access shared by the instance. Every workspace enters its own key in the UI (Settings,
# LLM access), stored encrypted; that is the normal way and this block can stay empty. These variables only
# serve a single-tenant instance, for a workspace that has no key of its own, until the import of an existing
# installation moves them into the default workspace (a multi-tenant instance ignores the key). A job whose
# workspace has no usable key fails when it is claimed with the error code llm_not_configured. The key is never
# logged or shown. ---

# The provider. Required. Only "openrouter" is supported for now.
LLM_PROVIDER=openrouter

# The API key of that provider (OpenRouter: openrouter.ai/keys). Required. Surrounding whitespace and
# a trailing line break are ignored. Keep it out of version control; only .env.local holds the value.
LLM_API_KEY=

# Optional. The model reviews use unless the review settings choose another. The OpenRouter name of the
# model, such as anthropic/claude-haiku-5.5 (without an openrouter/ prefix, the runner adds it).
# Default: anthropic/claude-haiku-5.5. A value that is not a model name is ignored with a start-up
# warning and the default is used.
# LLM_MODEL=anthropic/claude-haiku-5.5

# Optional. The context window (in tokens) of a model PR-Agent does not know; leave it unset for known
# models. A whole number from 1000 to 10000000; anything else is ignored with a start-up warning. The
# token budget of a review is a review setting and replaces this value in a job.
# LLM_MAX_TOKENS=163840

# --- Automatic reviews. Optional. A push to a pull request waits this many seconds before its review
# may start, so several pushes in a row produce one review (opened, reopened and ready-for-review
# reviews start at once). A whole number from 0 to 600; anything else is ignored with a start-up
# warning and the default is used. Default: 90. Every push restarts the wait, so a pull request that
# gets a push more often than this is reviewed once the pushes stop. ---
# REVIEW_DEBOUNCE_SECONDS=90
