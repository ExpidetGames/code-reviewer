# Copy to app/.env.local for local development. Placeholders only: never commit real values.
# The settings of the hosted deployment are listed in ../.env.example and docs/deployment-vercel.md.

# --- The database. The App needs a Postgres server (a throwaway container is enough:
# docker run -d --name cr-dev-pg -p 127.0.0.1:5432:5432 -e POSTGRES_PASSWORD=postgres postgres:18).
# The App never migrates by itself: run `pnpm migrate` first, and again after every pull that adds a migration. ---

# The URL the App connects with (postgres:// or postgresql://).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# The URL `pnpm migrate` and `pnpm setup-code` connect with (the migrate role in a deployment; for development the
# same as DATABASE_URL).
DATABASE_URL_MIGRATE=postgres://postgres:postgres@127.0.0.1:5432/postgres

# Optional. The most connections the pool opens (1 to 20). Default: 3.
# DATABASE_POOL_MAX=3

# --- The instance. APP_SECRET and BETTER_AUTH_URL are required; the server refuses to start without
# them and names what is missing. ---

# The master key of the instance. It signs the session cookie and encrypts the credentials stored in
# the database. At least 32 characters, random, never reused between environments. Create one with:
# openssl rand -base64 32
# Keep a copy apart from the database backups: a database restored without it loses every stored
# credential. Changing it signs everybody out and makes the stored tokens unreadable (they are
# replaced at the next sign in).
# (Left empty on purpose: the server will not start until you fill it in.)
APP_SECRET=

# Deprecated: the old name of APP_SECRET, still used as APP_SECRET while APP_SECRET is empty (and
# logged once as deprecated). A new instance never sets it.
# BETTER_AUTH_SECRET=

# The address people use to reach the app, without a path. An https address makes the cookies
# Secure; in production plain http is only accepted for localhost (browsers drop Secure cookies
# over http). Local development: http://localhost:3000
# (or the port you start `pnpm dev` on). GitHub sends people back to <this>/api/auth/callback/github,
# so that exact address is the "Callback URL" of the GitHub App (the one-click setup in the admin
# portal registers it for you).
BETTER_AUTH_URL=http://localhost:3000

# --- First start. A new instance is set up in the browser: until it is, everything but the health check
# waits for the setup. Run `pnpm setup-code` in a terminal after `pnpm migrate` (same APP_SECRET and database as
# the app), open the app, enter the code it prints and answer three questions (single or multi tenant, who may sign
# up, the admin account). Nothing about it is configured here. ---

# --- The GitHub App and "Sign in with GitHub" are configured in the admin portal (Integrations), not
# here: one click creates the App, or you enter its values by hand, and they are stored encrypted in the
# database (docs/github-app.md). ---

# --- Test stack only: point GitHub at the fake GitHub (fakes/github) instead of github.com. ---
# GITHUB_API_BASE_URL is where the GitHub API is reached (GitHub App JWT and installation tokens, the
# sign in's user and email lookups, the manifest conversion). GITHUB_OAUTH_BASE_URL is where GitHub's
# web pages are (the sign in's authorize and token exchange, the creation page of the manifest flow). Both are origins (the paths are GitHub's own). Defaults: https://api.github.com
# and https://github.com. Secrets are sent to these addresses (the client secret, the App JWT), so
# any other value is refused unless ALLOW_TEST_GITHUB_ENDPOINTS=true; the server then refuses to
# start with a message that names the variable (naming the real GitHub is always fine). Never set
# any of the three in production.
# ALLOW_TEST_GITHUB_ENDPOINTS=true
# GITHUB_OAUTH_BASE_URL=http://127.0.0.1:4010
# GITHUB_API_BASE_URL=http://127.0.0.1:4010

# Check LLM keys (the "test key" button of the LLM access settings) at a fake LLM instead of the provider.
# The address is ignored unless the flag is set too. A key is sent to it, so never set these in a real
# deployment.
# ALLOW_TEST_LLM_ENDPOINTS=true
# LLM_API_BASE_URL=http://127.0.0.1:4011/api/v1

# --- Deployment settings. The production server (`pnpm start`) refuses to start without them and names
# what is missing; `pnpm dev` does not check them. ---

# Worker API. The Dispatcher claims jobs over HTTP and proves itself with one shared token, the same
# value in the Dispatcher's environment. The production server refuses to start without it.
# Without RUNNER_TOKEN every call of the dispatcher API is refused (401), and so with one shorter than
# 32 characters (the server logs a warning at start). At least 32 characters, random.
# Create one with: openssl rand -hex 32
RUNNER_TOKEN=

# Optional. The model reviews use unless the review settings choose another. The OpenRouter name of the
# model, such as anthropic/claude-haiku-5.5 (without an openrouter/ prefix, the Worker adds it).
# Default: anthropic/claude-haiku-5.5. A value that is not a model name is ignored with a start-up
# warning and the default is used.
# LLM_MODEL=anthropic/claude-haiku-5.5

# Optional, default off. Set to 1 (or true, on) to run Dynamic reviews on OpenRouter and Anthropic through the native OpenCode
# path (#578, design #544): the claim carries the model entry and price of the catalog (models.dev) and the Worker starts the
# passthrough proxy. With it on, a model for the operator's key must be enabled with a confirmed price in the catalog.
# Anything else, or unset, keeps the path of today.
# NATIVE_OPENCODE_PROVIDERS=

# Optional. The context window (in tokens) of a model PR-Agent does not know; leave it unset for known
# models. A whole number from 1000 to 10000000; anything else is ignored with a start-up warning. The
# token budget of a review is decided by the app from the window of the model (no setting names it).
# LLM_MAX_TOKENS=163840
