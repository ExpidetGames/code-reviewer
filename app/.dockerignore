# Keeps the build context small and keeps secrets, tests and local data out of the image.
# Anything not listed here can end up in the "builder" stage, but only the standalone output is
# copied into the final image.

# Never in an image: environment files, keys, certificates, local databases
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
*.p12
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Version control and editor files
.git
.gitignore
.github
.vscode
.idea
.DS_Store

# Host build output and dependencies (the image installs and builds its own)
node_modules
**/node_modules
.next
out
build
dist
coverage
*.tsbuildinfo
next-env.d.ts
.pnpm-store

# Tests and test tooling
e2e
playwright-report
test-results
**/*.test.ts
**/*.test.tsx
**/*.integration.test.ts
**/*.integration.test.tsx
**/*.e2e.ts
src/test-support
src/ci
vitest.config.mts
playwright.config.ts

# Docker files themselves
Dockerfile
.dockerignore
